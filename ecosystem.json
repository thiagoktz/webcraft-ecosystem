  "infrastructure": {
    "database": {
      "provider": "supabase",
      "fallback": "cloudflare-d1",
      "tables": [
        "clients",
        "projects",
        "feedback_logs",
        "sessions"
      ]
    },
    "storage": {
      "provider": "cloudflare-r2",
      "purpose": "assets de mídia dos projetos"
    },
    "cache": {
      "provider": "cloudflare-kv",
      "purpose": "sessões ativas com TTL 24h"
    },
    "deploy": {
      "providers": [
        "vercel",
        "netlify",
        "cloudflare-pages"
      ]
    }
  },
