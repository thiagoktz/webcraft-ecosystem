    "updated_at": "2026-05-26"
  },
  "capabilities": [
    "site-institucional",
    "landing-page",
    "portfolio",
    "ecommerce-completo",
    "ecommerce-lite",
    "dashboard",
    "site-com-cms",
    "multilingual",
    "seo-audit",
    "redesign-textos",
    "backend-apenas",
    "adicionar-pagamento",
    "adicionar-cms"
  ],
  "agents": {
    "total": 14,
    "list": [
      {
        "id": "orchestrator",
        "role": "Coordena todos os agentes do ecossistema",
        "entry_point": "orchestrator/system-prompt.md"
      },
      {
        "id": "buscador-agent",
        "role": "Enriquece briefings com dados reais do Google Places: rating, reviews textuais, endereço, telefone, horário e foto",
        "entry_point": "agents/buscador-agent/system-prompt.md"
      },
      {
        "id": "analytics-agent",
        "role": "Instrumenta o site com GA4 + GTM, mapeia eventos de conversão e gera docs do cliente",
        "entry_point": "agents/analytics-agent/system-prompt.md"
      },
      {
        "id": "memory-agent",
        "role": "Mantém contexto do cliente entre sessões via Supabase/D1",
        "entry_point": "agents/memory-agent/system-prompt.md"
      },
      {
        "id": "design-agent",
        "role": "Define tokens visuais, direção de marca, tipografia e sistema de design",
        "entry_point": "agents/design-agent/system-prompt.md"
      },
      {
        "id": "content-agent",
        "role": "Pesquisa e especifica assets de mídia: imagens, ícones, ilustrações",
        "entry_point": "agents/content-agent/system-prompt.md"
      },
      {
        "id": "seo-agent",
        "role": "Realiza pesquisa de palavras-chave, gera meta tags otimizadas, estrutura dados schema",
        "entry_point": "agents/seo-agent/system-prompt.md"
      },
      {
        "id": "copy-agent",
        "role": "Escreve textos persuasivos e adequados ao tom da marca para todas as seções de um website",
        "entry_point": "agents/copy-agent/system-prompt.md"
      },
      {
        "id": "webcraft-agent",
        "role": "Desenvolve websites completos a partir de briefings em linguagem natural",
        "entry_point": "agents/webcraft-agent/system-prompt.md"
      },
      {
        "id": "qa-agent",
        "role": "Valida HTML, CSS, acessibilidade, SEO, performance e segurança antes da entrega",
        "entry_point": "agents/qa-agent/system-prompt.md"
      },
      {
        "id": "feedback-agent",
        "role": "Coleta, classifica e encaminha feedback do cliente",
        "entry_point": "agents/feedback-agent/system-prompt.md"
      },
      {
        "id": "backend-agent",
        "role": "Projeta e gera a camada de servidor: autenticação, APIs REST, schema de banco de dados e deploy em Cloudflare Workers ou Node",
        "entry_point": "agents/backend-agent/system-prompt.md"
      },
      {
        "id": "ecommerce-agent",
        "role": "Implementa pagamento real: Stripe, Mercado Pago, PagSeguro, PIX, boleto, parcelamento, webhooks e gestão de pedidos",
        "entry_point": "agents/ecommerce-agent/system-prompt.md"
      },
      {
        "id": "cms-agent",
        "role": "Cria painel administrativo para o cliente gerenciar textos, produtos, pedidos e mídia",
        "entry_point": "agents/cms-agent/system-prompt.md"
      }
    ]
  },
