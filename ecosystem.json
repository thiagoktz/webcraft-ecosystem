{
  "ecosystem": {
    "id": "webcraft-ecosystem",
    "name": "WebCraft Agent Ecosystem",
    "version": "2.3.0",
    "description": "Ecossistema multi-agente para desenvolvimento de websites profissionais",
    "maintainer": "thiagoktz",
    "repository": "https://github.com/thiagoktz/webcraft-ecosystem",
    "clients_repository": "https://github.com/thiagoktz/webcraft-clients",
