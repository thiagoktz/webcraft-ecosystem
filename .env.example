# WebCraft Ecosystem — credenciais locais (NÃO COMMITAR o .env real)
#
# Uso: copie este arquivo para .env (na raiz do checkout do Webcraft, fora do repo
# do ecosystem) e preencha os valores. O .env é lido por scripts de validação e
# pelo wrangler dev. Em produção, cada Worker recebe os mesmos valores via
# `wrangler secret put`.

# ---------------------------------------------------------------------------
# Google Places API (New)
# Como obter: https://console.cloud.google.com → APIs → Places API (New) → Credentials
# Restrições recomendadas: HTTP referrers OU IP, API restriction = Places API (New)
# Custo: pago, ~US$17/1k para Place Details (Enterprise) — cache obrigatório
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Unsplash API
# Como obter: https://unsplash.com/developers → New Application → Access Key
# Plano Demo: 50 req/h grátis. Production exige aprovação manual + UTM em links
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Cloudflare — Account ID (informativo; wrangler descobre via OAuth)
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Shared secret para autenticar chamadas ao Worker webcraft-cache-proxy.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usado como header X-WebCraft-Auth pelos agentes e pelo health-check.
WEBCRAFT_AUTH_TOKEN=
